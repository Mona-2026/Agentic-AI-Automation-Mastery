        "jsCode": "const item = $input.first();\n\nconst text =\n  item.json.text ||\n  item.json.data ||\n  item.json.extractedText ||\n  item.json.content ||\n  (item.binary && item.binary.data ? Buffer.from(item.binary.data.data, 'base64').toString('utf-8') : null);\n\nif (!text) {\n  throw new Error('No text found. Available json keys: ' + JSON.stringify(Object.keys(item.json)));\n}\n\nconst iocs = {\n  ips: [...new Set(text.match(/\\b\\d{1,3}(\\.\\d{1,3}){3}\\b/g) || [])],\n  hashes_md5: [...new Set(text.match(/\\b[a-fA-F0-9]{32}\\b/g) || [])],\n  hashes_sha256: [...new Set(text.match(/\\b[a-fA-F0-9]{64}\\b/g) || [])],\n  urls: [...new Set(text.match(/https?:\\/\\/[^\\s\"']+/g) || [])],\n  usernames: [...new Set([...text.matchAll(/user\\s*(?:account|name)?\\s*[:=]\\s*[\\r\\n]*\\s*([^\\r\\n]+)/gi)].map(m => m[1].trim()))],\n  hostnames: [...new Set([...text.matchAll(/host\\s*name?\\s*[:=]\\s*[\\r\\n]*\\s*([^\\r\\n]+)/gi)].map(m => m[1].trim()))],\n};\n\nreturn [{ json: { raw_log: text, iocs } }];"
