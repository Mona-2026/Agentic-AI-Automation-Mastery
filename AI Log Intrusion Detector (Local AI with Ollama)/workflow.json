      "parameters": {
        "jsCode": "let rawOutput = $json.output || $json.text || $json.data || '';\n\nif (typeof rawOutput === 'object' && rawOutput !== null) {\n  return { json: rawOutput, pairedItem: { item: 0 } };\n}\n\nconst jsonMatch = rawOutput.match(/\\{[\\s\\S]*\\}/);\n\nif (!jsonMatch) {\n  return {\n    json: {\n      threat_level: \"Unknown\",\n      attack_type: \"ParseError\",\n      source_ip: $json.source_ip || \"N/A\",\n      summary: \"AI response was not valid JSON: \" + rawOutput.substring(0, 200),\n      recommended_action: \"Manual review required\"\n    },\n    pairedItem: { item: 0 }\n  };\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(jsonMatch[0]);\n} catch (error) {\n  return {\n    json: {\n      threat_level: \"Unknown\",\n      attack_type: \"ParseError\",\n      source_ip: $json.source_ip || \"N/A\",\n      summary: \"JSON parsing failed: \" + error.message,\n      recommended_action: \"Manual review required\"\n    },\n    pairedItem: { item: 0 }\n  };\n}\n\nreturn {\n  json: {\n    threat_level: parsed.threat_level || \"Unknown\",\n    attack_type: parsed.attack_type || \"Unknown\",\n    source_ip: parsed.source_ip || $json.source_ip || \"N/A\",\n    summary: parsed.summary || \"No summary provided\",\n    recommended_action: parsed.recommended_action || \"No action specified\"\n  },\n  pairedItem: { item: 0 }\n};"
      },
